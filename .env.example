# Copy to `.env` for local overrides (never commit secrets).
# Markers: REQUIRED (dev) / REQUIRED (prod) / OPTIONAL

# --- REQUIRED (dev) — backend + ingest ---
# Async SQLAlchemy URL (see scaffold prompt / DEC-019).
#
# * Inside Docker Compose services, `db:5432` resolves to the PostGIS
#   container.
# * On your laptop, host-side tools (`scripts/ingest_dc.py`, Alembic via
#   `make migrate`) rewrite db/localhost DSNs to `127.0.0.1:<SCOUT_DB_HOST_PORT>`
#   when that variable is set below, so you can keep the Compose-style
#   `db:5432` URL here without duplicating the published port everywhere.
SCOUT_DATABASE_URL=postgresql+asyncpg://scout:scout@db:5432/scout

# --- REQUIRED (prod with real routing); OPTIONAL in dev when using stub provider ---
SCOUT_ORS_API_KEY=

# --- OPTIONAL — provider selection (defaults pick real implementations) ---
SCOUT_ROUTING_PROVIDER=openrouteservice
# Bundled DC Master Address Repository snapshot in Postgres (`dc_addresses`).
SCOUT_GEOCODING_PROVIDER=local_dc
SCOUT_RESTROOMS_PROVIDER=refuge

# --- OPTIONAL — provider base URLs (override for self-host / testing) ---
SCOUT_ORS_BASE_URL=https://api.heigit.org/openrouteservice
SCOUT_REFUGE_BASE_URL=https://www.refugerestrooms.org/api/v1

# --- OPTIONAL — runtime knobs ---
SCOUT_CACHE_DIR=./.scout-cache
SCOUT_LOG_LEVEL=INFO

# --- OPTIONAL — dev CORS allowlist (closed by default; PRD M1-F12) ---
# Comma-separated origins allowed to call the API from a browser. Compose
# pre-fills this with `http://localhost:${SCOUT_WEB_HOST_PORT:-3000}`, so set
# it here only to add extra origins (e.g. a second Storybook port). The
# production `runtime` image never reads Compose, so this stays closed in
# prod regardless of what's in your local .env.
# SCOUT_CORS_ALLOWLIST_CSV=http://localhost:3000,http://localhost:6006

# --- OPTIONAL — docker-compose host port overrides ---
# Container-internal ports never change; these only remap the host side.
# Useful if you already have Postgres on 5432, a Next dev server on 3000,
# or another API on 8080. Leave blank or unset to keep the defaults.
# SCOUT_DB_HOST_PORT=5433
# Matches the host-published Postgres port docker compose maps (:host -> :5432
# inside the container). Ingest rewires localhost/db DSNs to 127.0.0.1 here;
# GUI clients must type that port manually. For `make migrate`, export this
# var (or `source` .env) so Alembic sees it — it does not read `.env` by itself.
# SCOUT_BACKEND_HOST_PORT=8081
# SCOUT_WEB_HOST_PORT=3001

# --- OPTIONAL — web → backend URL (browser-side, must start with NEXT_PUBLIC_) ---
# Compose interpolates this from SCOUT_BACKEND_HOST_PORT (default 8080) so you
# normally don't set it directly. Override only if the backend runs somewhere
# the browser can't reach via `localhost:<SCOUT_BACKEND_HOST_PORT>`.
# NEXT_PUBLIC_SCOUT_API_BASE_URL=http://localhost:8080

# --- OPTIONAL — analytics (Umami Cloud hobby tier) ---
# Website ID from your Umami Cloud dashboard (https://cloud.umami.is).
# Leave unset to disable tracking (e.g. in dev/CI).
# SCOUT_UMAMI_WEBSITE_ID=

# --- OPTIONAL — release target (make release / make rollback) ---
# SSH destination for the production host (user@host or SSH config alias).
# Required by `make release`.
# SCOUT_DEPLOY_HOST=my-scout-server
# Path to the repo on the server (default: /home/deploy/scout).
# SCOUT_DEPLOY_DIR=/home/deploy/scout

# --- OPTIONAL — host-neutral production deploy (infra/docker-compose.prod.yml, DEC-025) ---
# Postgres password for the prod stack (no default — the prod compose fails
# without it). Dev uses the throwaway `scout` password baked into compose.
# SCOUT_DB_PASSWORD=
# Host port the in-image Caddy proxy is published on (container side is 8080).
# SCOUT_HTTP_PORT=8080
# Behind the in-image Caddy the real client IP arrives in X-Forwarded-For.
# Enable trust and (if your edge uses a different header) override the name —
# no code change needed to move hosts.
# SCOUT_TRUST_PROXY_HEADERS=true
# SCOUT_CLIENT_IP_HEADER=X-Forwarded-For
