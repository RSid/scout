# Copy to `.env` for local overrides (never commit secrets).
# Markers: REQUIRED (dev) / REQUIRED (prod) / OPTIONAL

# --- REQUIRED (dev) — backend + ingest ---
# Async SQLAlchemy URL (see scaffold prompt / DEC-019).
SCOUT_DATABASE_URL=postgresql+asyncpg://scout:scout@db:5432/scout

# REQUIRED (dev) — descriptive User-Agent on every Photon (geocoding) request.
# Photon's upstream community endpoint is "fair use"; a real contact in the UA
# lets upstream operators reach you before any block. (DEC-022 / AGENTS.md #12)
SCOUT_PHOTON_USER_AGENT=scout-dev/0.1 (you@example.com)

# --- REQUIRED (prod with real routing); OPTIONAL in dev when using stub provider ---
SCOUT_ORS_API_KEY=

# --- OPTIONAL — provider selection (defaults pick real implementations) ---
SCOUT_ROUTING_PROVIDER=openrouteservice
SCOUT_GEOCODING_PROVIDER=photon
SCOUT_RESTROOMS_PROVIDER=refuge

# --- OPTIONAL — provider base URLs (override for self-host / testing) ---
SCOUT_ORS_BASE_URL=https://api.openrouteservice.org
# Photon upstream — defaults to Komoot's community endpoint. The DEC-022
# follow-up PR brings up a self-hosted Photon on Fly and flips this URL
# to the internal Fly hostname.
SCOUT_PHOTON_BASE_URL=https://photon.komoot.io
SCOUT_REFUGE_BASE_URL=https://www.refugerestrooms.org/api/v1

# --- OPTIONAL — runtime knobs ---
SCOUT_CACHE_DIR=./.scout-cache
SCOUT_LOG_LEVEL=INFO

# --- OPTIONAL — dev CORS allowlist (closed by default; PRD M1-F12) ---
# Comma-separated origins allowed to call the API from a browser. Compose
# pre-fills this with `http://localhost:${SCOUT_WEB_HOST_PORT:-3000}`, so set
# it here only to add extra origins (e.g. a second Storybook port). The
# production `runtime` image never reads Compose, so this stays closed in
# prod regardless of what's in your local .env.
# SCOUT_CORS_ALLOWLIST_CSV=http://localhost:3000,http://localhost:6006

# --- OPTIONAL — docker-compose host port overrides ---
# Container-internal ports never change; these only remap the host side.
# Useful if you already have Postgres on 5432, a Next dev server on 3000,
# or another API on 8080. Leave blank or unset to keep the defaults.
# SCOUT_DB_HOST_PORT=5433
# SCOUT_BACKEND_HOST_PORT=8081
# SCOUT_WEB_HOST_PORT=3001

# --- OPTIONAL — web → backend URL (browser-side, must start with NEXT_PUBLIC_) ---
# Compose interpolates this from SCOUT_BACKEND_HOST_PORT (default 8080) so you
# normally don't set it directly. Override only if the backend runs somewhere
# the browser can't reach via `localhost:<SCOUT_BACKEND_HOST_PORT>`.
# NEXT_PUBLIC_SCOUT_API_BASE_URL=http://localhost:8080
