# In-image reverse proxy for the Scout runtime (DEC-025).
#
# Makes the image self-contained behind a single public port so it runs
# unchanged on any host (VPS, Cloud Run, Render, ...) with no host-provided
# proxy. TLS is terminated by whatever platform sits in front, so we serve
# plain HTTP here and let the platform handle HTTPS.
#
#   /api/*  -> FastAPI / uvicorn on loopback :8081
#   /*      -> Next.js standalone server on loopback :3000
#
# $PORT is supplied by the host (Cloud Run / Render / etc.); defaults to 8080
# for local + docker-compose use.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	# Security headers for every response, Next and FastAPI alike (AGENTS.md
	# "Security and privacy posture"; M1-F15). `defer` applies them when the
	# response is written, so they also cover proxied responses and replace
	# anything the upstream set instead of duplicating it.
	header {
		defer

		# Enforced CSP. Each source beyond 'self' is commented with why it is
		# allowed; add new ones only with a comment.
		#   script-src 'unsafe-inline': Next.js inlines its bootstrap/RSC payload
		#     scripts into statically prerendered HTML. Nonces would make every
		#     page per-request (no static or CDN-cacheable HTML), which the owner
		#     rejected.
		#   script-src https://cloud.umami.is: Umami Cloud tracker, the only
		#     approved analytics (apps/web/app/layout.tsx). Caddy can't tell
		#     whether SCOUT_UMAMI_WEBSITE_ID was set at build time, so the
		#     origin is always allowed; unused when the env var is empty.
		#   connect-src https://gateway.umami.is: where that tracker POSTs
		#     events (`/api/send`; its default host when no data-host-url).
		#   style-src 'unsafe-inline': React/Next and MapLibre write inline
		#     style attributes and <style> tags.
		#   img-src data:: marker sprites and list thumbnails are SVG data: URIs
		#     (apps/web/lib/map/markers.ts).
		#   img-src blob:: MapLibre's image-decoding fallback for browsers
		#     without createImageBitmap loads images from blob: URLs.
		# Tiles (/tiles/dc.pmtiles), glyphs (/fonts/glyphs) and markers are
		# same-origin, and the MapLibre worker is a same-origin hashed asset
		# (setWorkerUrl in BasemapInner.tsx). MapLibre only falls back to blob:
		# workers for cross-origin worker URLs, so worker-src needs no blob:.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cloud.umami.is; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://gateway.umami.is; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'"

		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"

		# Deny powerful features by default. geolocation=(self) keeps the
		# planner's "Use my location" button working (AddressAutocomplete).
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(self), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), browsing-topics=()"

		# TLS terminates at the host edge in front of this container. Browsers
		# ignore HSTS received over plain HTTP, so local http:// use is
		# unaffected. No includeSubDomains or preload: other subdomains of the
		# production domain aren't ours to vouch for, and preload is hard to undo.
		Strict-Transport-Security "max-age=31536000"

		# Redundant with frame-ancestors 'none', kept for browsers that predate it.
		X-Frame-Options "DENY"

		# Don't advertise the stack (Next's X-Powered-By, uvicorn's/Caddy's Server).
		-X-Powered-By
		-Server
	}

	handle /api/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
